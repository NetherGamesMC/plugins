parameters:
	ignoreErrors:
		-
			message: '#^Match arm comparison between ''egg'' and ''egg'' is always true\.$#'
			identifier: match.alwaysTrue
			count: 1
			path: src/lobby/features/presents/Presents.php

		-
			message: '#^Match arm comparison between ''egg'' and ''present'' is always false\.$#'
			identifier: match.alwaysFalse
			count: 1
			path: src/lobby/features/presents/Presents.php

		-
			message: '#^Strict comparison using \=\=\= between ''candy bundle'' and ''egg'' will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: src/lobby/features/presents/Presents.php

		-
			message: '#^Constant lobby\\utils\\npc\\Button\:\:MODE_ON_CLOSE is unused\.$#'
			identifier: classConstant.unused
			count: 1
			path: src/lobby/utils/npc/Button.php

		-
			message: '#^Constant lobby\\utils\\npc\\Button\:\:TYPE_INVALID is unused\.$#'
			identifier: classConstant.unused
			count: 1
			path: src/lobby/utils/npc/Button.php

		-
			message: '#^Constant lobby\\utils\\npc\\Button\:\:TYPE_URL is unused\.$#'
			identifier: classConstant.unused
			count: 1
			path: src/lobby/utils/npc/Button.php
