{
  "name": "nethergamesmc/libasyncio",
  "description": "An async library for PocketMine-MP",
  "license": "proprietary",
  "type": "project",
  "version": "dev-stable",
  "require": {
    "php": "^8.0",
    "ext-igbinary": "*"
  },
  "require-dev": {
    "phpstan/phpstan": "2.1.29",
    "nethergamesmc/pocketmine-mp": "dev-stable",
    "nethergamesmc/ngessentials": "dev-stable"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../NGEssentials",
      "options": {
        "versions": {
          "nethergamesmc/ngessentials": "dev-stable"
        }
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "libasyncio\\": "/"
    }
  },
  "minimum-stability": "dev"
}
